<?xml version="1.0" encoding="utf-8"?>
<!--
    Laid out to fit a 3x1 cell (roughly 250x80dp): three tight rows, no
    progress bar. The refresh button sits right after the "Updated" time,
    on the last row, which is never hidden.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Its alpha is the user's opacity setting. -->
    <ImageView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background" />

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="10dp">

    <TextView
        android:id="@+id/placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:textColor="@color/widget_text"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Always visible: signal, network type, battery, unread SMS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/signal"
                android:layout_width="19dp"
                android:layout_height="16dp"
                android:contentDescription="@string/signal_desc"
                android:src="@drawable/ic_signal_none" />

            <TextView
                android:id="@+id/mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:textColor="@color/widget_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Icon and percentage travel together, pinned to the right. -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/battery_icon"
                    android:layout_width="18dp"
                    android:layout_height="9dp"
                    android:layout_marginEnd="3dp"
                    android:contentDescription="@string/battery_desc"
                    android:src="@drawable/ic_battery_100" />

                <TextView
                    android:id="@+id/battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="@color/widget_text"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sms_block"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/sms_icon"
                    android:layout_width="12dp"
                    android:layout_height="9dp"
                    android:layout_marginEnd="3dp"
                    android:contentDescription="@string/sms_desc"
                    android:src="@drawable/ic_sms" />

                <TextView
                    android:id="@+id/sms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="@color/widget_text"
                    android:textSize="15sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Hidden on very short widgets, see TendaWidgetProvider.render -->
        <TextView
            android:id="@+id/operator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_muted"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/traffic"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/footer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_muted"
                android:textSize="11sp" />

            <!-- While a manual poll runs the icon is swapped for the spinner. -->
            <FrameLayout
                android:id="@+id/refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="4dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <ImageView
                    android:id="@+id/refresh_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@string/refresh_desc"
                    android:src="@drawable/ic_refresh" />

                <ProgressBar
                    android:id="@+id/refresh_spinner"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:indeterminate="true"
                    android:indeterminateDrawable="@drawable/refresh_spinning"
                    android:indeterminateDuration="1000"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
    </LinearLayout>
</FrameLayout>
